# ClearPath Justice Agent - Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# --- DeepSeek LLM API ---
# Required. Get your key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com

# --- Server ---
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS (comma-separated origins; tighten in production) ---
CORS_ORIGINS=*

# --- Privacy / data handling ---
# When true, the agent will refuse to store free-text fields that look
# like South African ID numbers or other high-risk identifiers, and will
# redact them before logging. Keep this true in all environments.
PII_GUARD_ENABLED=true
